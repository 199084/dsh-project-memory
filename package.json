{
  "name": "dsh-project-memory",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Human-owned, project-scoped memory for DeepSeek Harness: MEMORY.md as labeled runtime context, read-only lookups with line citations, and lazy, human-approved memory updates. DeepSeek Harness 项目记忆插件：由人掌控，随仓库版本化，带来源注入与只读检索。",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "project-memory",
    "agent-memory",
    "plugin"
  ]
}
